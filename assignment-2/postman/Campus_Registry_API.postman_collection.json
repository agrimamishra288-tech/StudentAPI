{
  "info": {
    "_postman_id": "b7a1c0e2-4d3f-4a8e-9b6c-2f1d8a3e5c74",
    "name": "Campus Registry API - Lab 2",
    "description": "Campus Registry API - Lab Assignment 2, Web Dev III, Unit 2.\n\nRun the \"CRUD - run in order\" folder top to bottom. The create request stores the new id in a collection variable so the read, update and delete requests use the same record. The \"Error handling\" folder checks every 400 and 404 case.\n\nBase URL: http://localhost:3000\nNo database is used; restarting the server restores the three seed students.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD - run in order",
      "item": [
        {
          "name": "01 - Get all students (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the expected message', () => {",
                  "  pm.expect(body.message).to.eql('Student records retrieved.');",
                  "});",
                  "pm.test('Students is a non-empty array', () => {",
                  "  pm.expect(body.students).to.be.an('array');",
                  "  pm.expect(body.students.length).to.be.above(0);",
                  "});",
                  "pm.test('Every record has the expected fields', () => {",
                  "  body.students.forEach((student) => {",
                  "    pm.expect(student).to.have.all.keys('id', 'name', 'age', 'course', 'email');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
            },
            "description": "Returns every student record from the in-memory array."
          },
          "response": []
        },
        {
          "name": "02 - Get one student (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns student 1', () => {",
                  "  pm.expect(body.message).to.eql('Student record retrieved.');",
                  "  pm.expect(body.student.id).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["students", "1"]
            },
            "description": "Reads a single seeded student by id."
          },
          "response": []
        },
        {
          "name": "03 - Create student (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Keep the email unique so the folder can be run more than once.",
                  "pm.variables.set('demoEmail', `postman.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('A new id was assigned', () => {",
                  "  pm.expect(body.message).to.eql('Student record created.');",
                  "  pm.expect(body.student.id).to.be.a('number');",
                  "});",
                  "pm.test('Fields were saved as sent', () => {",
                  "  pm.expect(body.student.name).to.eql('Postman Demo');",
                  "  pm.expect(body.student.course).to.eql('B.Tech CSE');",
                  "  pm.expect(body.student.age).to.eql(20);",
                  "});",
                  "pm.collectionVariables.set('createdStudentId', body.student.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo\",\n  \"age\": 20,\n  \"course\": \"B.Tech CSE\",\n  \"email\": \"{{demoEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
            },
            "description": "Creates a record and saves its id as createdStudentId for the next requests."
          },
          "response": []
        },
        {
          "name": "04 - Get created student (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the record created in request 03', () => {",
                  "  pm.expect(String(body.student.id)).to.eql(String(pm.collectionVariables.get('createdStudentId')));",
                  "  pm.expect(body.student.name).to.eql('Postman Demo');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/{{createdStudentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["students", "{{createdStudentId}}"]
            },
            "description": "Reads the record created in the previous request. Run request 03 first."
          },
          "response": []
        },
        {
          "name": "05 - Update student (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('The record was updated', () => {",
                  "  pm.expect(body.message).to.eql('Student record updated.');",
                  "  pm.expect(body.student.name).to.eql('Postman Demo (edited)');",
                  "  pm.expect(body.student.course).to.eql('BCA');",
                  "  pm.expect(body.student.age).to.eql(21);",
                  "});",
                  "pm.test('The id did not change', () => {",
                  "  pm.expect(String(body.student.id)).to.eql(String(pm.collectionVariables.get('createdStudentId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo (edited)\",\n  \"age\": 21,\n  \"course\": \"BCA\",\n  \"email\": \"{{demoEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/{{createdStudentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["students", "{{createdStudentId}}"]
            },
            "description": "Replaces the editable fields on the created record. Run request 03 first."
          },
          "response": []
        },
        {
          "name": "06 - Delete student (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('The deleted record is returned', () => {",
                  "  pm.expect(body.message).to.eql('Student record deleted.');",
                  "  pm.expect(String(body.student.id)).to.eql(String(pm.collectionVariables.get('createdStudentId')));",
                  "});",
                  "pm.collectionVariables.set('createdStudentId', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/{{createdStudentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["students", "{{createdStudentId}}"]
            },
            "description": "Deletes the record created in request 03 and clears the stored id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error handling",
      "item": [
        {
          "name": "400 - Invalid id format",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Explains the bad id', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Student id must be a positive whole number.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/abc",
              "host": ["{{baseUrl}}"],
              "path": ["students", "abc"]
            },
            "description": "Non-numeric ids are rejected before any lookup."
          },
          "response": []
        },
        {
          "name": "400 - Missing / invalid fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Returns the validation message', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Provide a name, age, course and email. Age must be a positive whole number.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
            },
            "description": "An empty body is caught by the validation block."
          },
          "response": []
        },
        {
          "name": "400 - Malformed JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Reports invalid JSON', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Request body is not valid JSON.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Broken\" ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
            },
            "description": "The central error handler turns a JSON parse failure into a 400 instead of a 500."
          },
          "response": []
        },
        {
          "name": "404 - Missing student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Reports the missing student', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('No student exists with that id.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/9999",
              "host": ["{{baseUrl}}"],
              "path": ["students", "9999"]
            },
            "description": "A valid id that does not exist in the array."
          },
          "response": []
        },
        {
          "name": "404 - Unknown route",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Reports a route problem', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('That endpoint does not exist.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"]
            },
            "description": "The app-level 404 catches anything outside the student router."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "createdStudentId",
      "value": ""
    },
    {
      "key": "demoEmail",
      "value": "postman.demo@example.com"
    }
  ]
}
